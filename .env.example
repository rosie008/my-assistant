# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS= # Optional: Comma-separated user IDs e.g. 12345678,87654321

# ==============================================================================
# Model Providers Configuration
# ==============================================================================
# Active Provider: gemini | openai | local
DEFAULT_PROVIDER=gemini

# Google Gemini / AGY
# Supports API Key or Google Application Default Credentials / Device Login
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / Codex / Compatible
OPENAI_API_KEY=your_openai_api_key_here
# Select api_key or codex_cli. If unset, api_key is used when OPENAI_API_KEY exists.
OPENAI_AUTH_MODE=api_key
# Optional executable path when codex is not on PATH.
CODEX_CLI_PATH=codex
OPENAI_MODEL=gpt-4o

# Local Model (Ollama, vLLM, LM Studio, llama.cpp)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5-coder:7b
LOCAL_API_KEY=ollama

# ==============================================================================
# Complex Credentials / Passwords Test (Regardless of passwords/symbols)
# ==============================================================================
DATABASE_PASSWORD="p@$$w0rd!#%^&*()_+=~`{}[]|;:'<>,.?/"
SPECIAL_TOKEN='complex$token#with=equals&and!quotes"'
REDIS_SECRET=unquoted_pass_with_special!#123
